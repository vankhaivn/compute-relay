 objects are accepted within operator limits (2 GiB default). 201 is sent only after verified blob publication and ownership metadata commit; production SQLite composition is deferred. No resumable upload or deduplication promise.","parameters":[{"name":"X-Content-SHA256","in":"header","required":false,"schema":{"$ref":"./schemas/common.v1alpha1.schema.json#/$defs/sha256"}}],"requestBody":{"required":true,"content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}},"application/gzip":{"schema":{"type":"string","format":"binary"}}}},"responses":{"201":{"description":"Verified bytes and workspace ownership metadata committed","content":{"application/json":{"schema":{"$ref":"./schemas/object.v1alpha1.schema.json"}}},"headers":{"Location":{"schema":{"type":"string","format":"uri-reference"},"description":"Workspace-scoped metadata URI"},"X-Request-ID":{"$ref":"#/components/headers/RequestID"}}},"400":{"$ref":"#/components/responses/Error400WithHeaders"},"401":{"$ref":"#/components/responses/Error401WithHeaders"},"403":{"$ref":"#/components/responses/Error403WithHeaders"},"408":{"$ref":"#/components/responses/Error408WithHeaders"},"413":{"$ref":"#/components/responses/Error413WithHeaders"},"415":{"$ref":"#/components/responses/Error415WithHeaders"},"429":{"$ref":"#/components/responses/Error429WithHeaders"},"503":{"$ref":"#/components/responses/Error503WithHeaders"}}}},"/v1/workspaces/{workspace_id}/objects/{object_id}":{"parameters":[{"name":"workspace_id","in":"path","required":true,"schema":{"$ref":"./schemas/common.v1alpha1.schema.json#/$defs/workspace_id"}},{"name":"object_id","in":"path","required":true,"schema":{"$ref":"./schemas/common.v1alpha1.schema.json#/$defs/object_id"}}],"get":{"summary":"Read committed workspace object metadata","operationId":"getObject","tags":["objects"],"x-implementation-status":"implemented-offline","description":"Requires read scope. Does not expose host paths or provider URLs. An absent or foreign object has the same 404 response. Uncommitted filesystem bytes are not visible here.","responses":{"200":{"description":"Immutable object metadata","content":{"application/json":{"schema":{"$ref":"./schemas/object.v1alpha1.schema.json"}}},"headers":{"X-Request-ID":{"$ref":"#/components/headers/RequestID"}}},"400":{"$ref":"#/components/responses/Error400WithHeaders"},"401":{"$ref":"#/components/responses/Error401WithHeaders"},"403":{"$ref":"#/components/responses/Error403WithHeaders"},"404":{"$ref":"#/components/responses/Error404WithHeaders"},"429":{"$ref":"#/components/responses/Error429WithHeaders"},"503":{"$ref":"#/components/responses/Error503WithHeaders"}}}},"/v1/workspaces/{workspace_id}/objects/import":{"parameters":[{"name":"workspace_id","in":"path","required":true,"schema":{"$ref":"./schemas/common.v1alpha1.schema.json#/$defs/workspace_id"}}],"post":{"summary":"Snapshot explicitly allowed local files or a bundle","operationId":"importObject","tags":["objects"],"x-implementation-status":"implemented-offline","description":"Disabled unless the operator configures a named root allowed for this workspace. Requires write scope. File mode copies one relative file; bundle mode requires explicit relative includes. No absolute paths, implicit whole-root import, extraction or workload execution. Defaults: 2 GiB raw file; 100 MiB compressed and 500 MiB expanded bundle. Changed source bytes fail instead of publishing an inconsistent object. Uses the existing verified-byte and ownership-commit boundary; production SQLite/configuration composition remains deferred.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"./schemas/object-import.v1alpha1.schema.json"}}}},"responses":{"201":{"description":"Verified bytes and workspace ownership metadata committed","content":{"application/json":{"schema":{"$ref":"./schemas/object.v1alpha1.schema.json"}}},"headers":{"Location":{"schema":{"type":"string","format":"uri-reference"},"description":"Workspace-scoped m