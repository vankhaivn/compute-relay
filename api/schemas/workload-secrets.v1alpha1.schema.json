{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay workload-secrets v1alpha1",
  "$defs": {
    "Slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "exposure"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "exposure": {
          "type": "string",
          "enum": [
            "file",
            "file_and_local_process_arguments"
          ]
        }
      }
    },
    "SupplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "readiness_revision",
        "expires_at",
        "values"
      ],
      "description": "The server enforces a maximum decoded aggregate of 32 KiB and an expiry no more than 24 hours after acceptance.",
      "properties": {
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "readiness_revision": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "writeOnly": true,
            "minLength": 4,
            "maxLength": 10924,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "description": "Standard base64-encoded, nonempty slot value (up to 8 KiB decoded)."
          },
          "description": "Write-only secret values; never returned in receipts or readiness."
        }
      }
    },
    "RevokeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "workspace_id",
        "job_id",
        "attempt_id",
        "readiness_revision",
        "expires_at",
        "names",
        "status",
        "created_at",
        "consumed_at",
        "revoked_at",
        "replay"
      ],
      "properties": {
        "authorization_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/operation_id"
        },
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/workspace_id"
        },
        "job_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/job_id"
        },
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "readiness_revision": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "granted",
            "consumed",
            "revoked",
            "expired"
          ]
        },
        "created_at": {
          "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
        },
        "consumed_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
            }
          ]
        },
        "revoked_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
            }
          ]
        },
        "replay": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "consumed"
              }
            }
          },
          "then": {
            "properties": {
              "consumed_at": {
                "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
              },
              "revoked_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "consumed_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "revoked"
              }
            }
          },
          "then": {
            "properties": {
              "revoked_at": {
                "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
              }
            }
          },
          "else": {
            "properties": {
              "revoked_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_slots",
        "status"
      ],
      "properties": {
        "required_slots": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Slot"
          }
        },
        "authorization_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/operation_id"
        },
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "available",
            "material_lost",
            "expired",
            "revoked",
            "consumed"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SupplyRequest"
    },
    {
      "$ref": "#/$defs/RevokeRequest"
    },
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/Readiness"
    }
  ]
}
