        {
          "$ref": "#/$defs/unavailable_metric"
        }
      ]
    },
    "power_source_metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "string",
              "enum": [
                "ac",
                "battery"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/unavailable_metric"
        }
      ]
    },
    "battery_charge_percent_metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "$ref": "#/$defs/unavailable_metric"
        }
      ]
    },
    "battery_charging_metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "$ref": "#/$defs/unavailable_metric"
        }
      ]
    },
    "battery_temperature_celsius_metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "number",
              "minimum": -50.05,
              "maximum": 100
            }
          }
        },
        {
          "$ref": "#/$defs/unavailable_metric"
        }
      ]
    },
    "battery_cycle_count_metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
