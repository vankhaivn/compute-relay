          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "one",
                "five",
                "fifteen"
              ],
              "properties": {
                "one": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000.0
                },
                "five": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000.0
                },
                "fifteen": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000.0
                }
              }
            }
          }
        },
        {
          "$ref": "#/$defs/unavailable_metric"
