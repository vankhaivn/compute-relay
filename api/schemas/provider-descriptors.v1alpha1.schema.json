{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay provider-descriptors v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providers"
  ],
  "properties": {
    "providers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "label",
          "credential_fields",
          "capabilities",
          "credential_storage"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "credential_fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "label",
                "required",
                "write_only",
                "max_bytes"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "required": {
                  "type": "boolean"
                },
                "write_only": {
                  "const": true
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                }
              }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accelerators",
              "remote_cancel",
              "quota"
            ],
            "properties": {
              "accelerators": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 8,
                "items": {
                  "enum": [
                    "cpu",
                    "gpu",
                    "tpu"
                  ]
                }
              },
              "remote_cancel": {
                "enum": [
                  "supported",
                  "unsupported",
                  "unknown"
                ]
              },
              "quota": {
                "enum": [
                  "supported",
                  "unsupported",
                  "unknown"
                ]
              },
              "absolute_execution_deadline": {
                "description": "Whether this adapter enforces immutable absolute UTC execution deadlines. Omission means unknown.",
                "enum": [
                  "supported",
                  "unsupported",
                  "unknown"
                ]
              },
              "separate_prepare_start": {
                "enum": [
                  "supported",
                  "unsupported",
                  "unknown"
                ]
              },
              "ephemeral_workload_secrets": {
                "$ref": "common.v1alpha1.schema.json#/$defs/capability_support"
              },
              "concurrency": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "support",
                  "scope",
                  "minimum",
                  "maximum",
                  "default"
                ],
                "properties": {
                  "support": {
                    "const": "supported"
                  },
                  "scope": {
                    "enum": [
                      "account",
                      "resource"
                    ]
                  },
                  "minimum": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "maximum": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "default": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  }
                },
                "description": "Local concurrency policy range; not a promise of provider session capacity or quota. Omission means unknown support."
              },
              "remote_cleanup": {
                "enum": [
                  "supported",
                  "unsupported",
                  "unknown"
                ]
              }
            }
          },
          "credential_storage": {
            "enum": [
              "available",
              "unavailable",
              "unsupported"
            ]
          }
        }
      }
    }
  }
}
