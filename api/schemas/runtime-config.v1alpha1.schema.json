{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay normalized runtime configuration v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "server",
    "storage",
    "scheduler",
    "execution",
    "policy",
    "providers",
    "profiles",
    "workspaces",
    "retention"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listen",
        "auth_required"
      ],
      "properties": {
        "listen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "auth_required": {
          "const": true
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_dir",
        "blob_dir",
        "max_local_bytes",
        "min_free_bytes"
      ],
      "properties": {
        "state_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "blob_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "max_local_bytes": {
          "type": "integer",
          "minimum": 1048576
        },
        "min_free_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_active_per_account",
        "max_queued_per_workspace",
        "max_queued_total",
        "status_poll_seconds"
      ],
      "properties": {
        "max_active_per_account": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_queued_per_workspace": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_queued_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "status_poll_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_remote_wall_seconds",
        "setup_seconds",
        "finalization_grace_seconds",
        "automatic_compute_retries"
      ],
      "properties": {
        "default_remote_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "setup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600
        },
        "finalization_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "automatic_compute_retries": {
          "const": 0
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "free_only",
        "allow_remote_internet",
        "automatic_provider_fallback",
        "unknown_quota"
      ],
      "properties": {
        "free_only": {
          "const": true
        },
        "allow_remote_internet": {
          "type": "boolean"
        },
        "automatic_provider_fallback": {
          "const": false
        },
        "unknown_quota": {
          "type": "string",
          "enum": [
            "warn_and_allow_bounded",
            "strict_block"
          ]
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "common.v1alpha1.schema.json#/$defs/profile_name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "enabled",
          "credential_ref",
          "cost_class"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "enabled": {
            "type": "boolean"
          },
          "credential_ref": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1024,
            "pattern": "^(?:env:[A-Za-z_][A-Za-z0-9_]*|file:.+)$"
          },
          "account_scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "cost_class": {
            "type": "string",
            "enum": [
              "free_allowance",
              "operator_managed"
            ]
          },
          "private_resources": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "common.v1alpha1.schema.json#/$defs/profile_name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "accelerator",
          "remote_internet"
        ],
        "properties": {
          "provider": {
            "$ref": "common.v1alpha1.schema.json#/$defs/profile_name"
          },
          "accelerator": {
            "type": "string",
            "enum": [
              "cpu",
              "gpu"
            ]
          },
          "minimum_gpu_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "remote_internet": {
            "type": "string",
            "enum": [
              "disabled",
              "allowed",
              "required"
            ]
          }
        }
      }
    },
    "workspaces": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1024,
      "propertyNames": {
        "$ref": "common.v1alpha1.schema.json#/$defs/profile_name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed_profiles"
        ],
        "properties": {
          "allowed_profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "$ref": "common.v1alpha1.schema.json#/$defs/profile_name"
            }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_metadata_days",
        "artifacts_days",
        "completed_input_days",
        "unreferenced_object_hours"
      ],
      "properties": {
        "job_metadata_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "artifacts_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "completed_input_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "unreferenced_object_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 87600
        }
      }
    }
  }
}
