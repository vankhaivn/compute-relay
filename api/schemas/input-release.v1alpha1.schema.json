{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay local input release v1alpha1",
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "attempt_id",
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "job_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/job_id"
        },
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "artifact_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/artifact_id"
        },
        "sha256": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        }
      }
    },
    "preview_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs",
        "preview_sha256"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "preview_sha256": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "jobs",
        "preview_sha256",
        "files",
        "releasable_bytes",
        "measured_at"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/workspace_id"
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "preview_sha256": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "releasable_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "measured_at": {
          "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "jobs",
        "preview_sha256",
        "released_at",
        "files",
        "bytes",
        "pending_files",
        "reclaimed_bytes"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/workspace_id"
        },
        "jobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/job"
          }
        },
        "preview_sha256": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "released_at": {
          "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pending_files": {
          "type": "integer",
          "minimum": 0
        },
        "reclaimed_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/preview_request"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/preview"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ]
}
