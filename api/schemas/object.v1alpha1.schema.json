{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay immutable object metadata v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "workspace_id",
    "bytes",
    "sha256"
  ],
  "properties": {
    "object_id": {
      "$ref": "common.v1alpha1.schema.json#/$defs/object_id"
    },
    "workspace_id": {
      "$ref": "common.v1alpha1.schema.json#/$defs/workspace_id"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "sha256": {
      "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
    }
  }
}
