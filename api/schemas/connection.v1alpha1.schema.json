{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay connection v1alpha1",
  "$defs": {
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "workspace_id",
        "revision",
        "provider_type",
        "label",
        "authentication",
        "credential_present",
        "new_work",
        "account_id",
        "selection",
        "quotas",
        "active_attempts",
        "updated_at"
      ],
      "properties": {
        "connection_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/workspace_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "provider_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authentication": {
          "enum": [
            "pending",
            "verified",
            "rejected",
            "unavailable"
          ]
        },
        "credential_present": {
          "type": "boolean"
        },
        "new_work": {
          "enum": [
            "enabled",
            "disabled",
            "removed"
          ]
        },
        "account_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
            }
          ]
        },
        "selection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "configuration_revision",
                "max_remote_wall_seconds",
                "allow_remote_internet"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
                },
                "configuration_revision": {
                  "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
                },
                "max_remote_wall_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 604800
                },
                "allow_remote_internet": {
                  "type": "boolean"
                },
                "accelerator": {
                  "enum": [
                    "cpu",
                    "gpu",
                    "tpu"
                  ],
                  "description": "Exact frozen resource policy. Omitted for legacy profiles; clients must not infer it from the current provider descriptor."
                },
                "max_active_attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "description": "Frozen local concurrency limit; account and verified resource aliases share the most restrictive applicable limit. Default 1."
                },
                "max_processes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536,
                  "description": "Maximum processes per container for an operator host."
                }
              }
            }
          ]
        },
        "quotas": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "resource",
              "unit",
              "remaining",
              "observed_at",
              "precision"
            ],
            "properties": {
              "status": {
                "enum": [
                  "known",
                  "unknown",
                  "stale"
                ]
              },
              "resource": {
                "enum": [
                  "cpu",
                  "gpu",
                  "tpu"
                ]
              },
              "unit": {
                "const": "seconds"
              },
              "remaining": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              },
              "observed_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
                  }
                ]
              },
              "precision": {
                "enum": [
                  "lower_bound",
                  "unknown"
                ]
              },
              "limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Observed total allowance in seconds, rounded down; absent when unknown."
              },
              "used": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Observed provider usage in seconds, rounded up; not inferred from remaining capacity."
              },
              "local_reserved": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Finite GPU seconds reserved by Relay work for this account; provider reservations are already included in remaining and are not repeated here."
              },
              "reset_at": {
                "anyOf": [
                  {
                    "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Provider-evidenced reset time only; absence is unknown and never grants allowance."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "known"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "remaining": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_at": {
                      "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
                    },
                    "precision": {
                      "const": "lower_bound"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "remaining": {
                      "type": "null"
                    },
                    "precision": {
                      "const": "unknown"
                    }
                  }
                }
              }
            ]
          }
        },
        "active_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_remote_wall_seconds"
          ],
          "properties": {
            "max_remote_wall_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800,
              "description": "Maximum remote wall time in seconds for future job admissions. The provider type's advertised max_remote_wall_seconds also applies."
            },
            "max_active_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "Maximum concurrent attempts for an operator host; aliases share the lowest retained limit."
            },
            "max_processes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536,
              "description": "Maximum processes per container for an operator host."
            },
            "storage_budget": {
              "$ref": "common.v1alpha1.schema.json#/$defs/storage_budget_configuration"
            },
            "host_health": {
              "$ref": "common.v1alpha1.schema.json#/$defs/host_health_configuration"
            }
          },
          "description": "Explicit persisted policy override; omission means the existing startup default."
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "description": "Last successful host verification; retained after a failed recheck. Contains no endpoint or login identity.",
          "required": [
            "host_key_fingerprint",
            "os",
            "architecture"
          ],
          "properties": {
            "host_key_fingerprint": {
              "type": "string",
              "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
            },
            "os": {
              "const": "linux"
            },
            "architecture": {
              "enum": [
                "amd64",
                "arm64"
              ]
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "recipe_sha256"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "missing",
                    "ready"
                  ]
                },
                "recipe_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "id": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "ready"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "id"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "id"
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "resource",
            "configured_limit",
            "effective_limit",
            "active_attempts",
            "wait_reason"
          ],
          "properties": {
            "scope": {
              "enum": [
                "account",
                "resource"
              ]
            },
            "resource": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "resource_id"
                  ],
                  "properties": {
                    "kind": {
                      "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
                    },
                    "resource_id": {
                      "type": "string",
                      "pattern": "^resource_[0-9a-f]{64}$"
                    }
                  },
                  "description": "Opaque verified scheduling resource. Native machine identifiers and connection endpoints are never exposed."
                }
              ]
            },
            "configured_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "effective_limit": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              ]
            },
            "active_attempts": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            },
            "wait_reason": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "connection_unverified",
                    "resource_identity_unverified",
                    "resource_reservation_unresolved",
                    "scheduler_clock_unavailable",
                    "scheduler_paused",
                    "account_disabled",
                    "worker_limit",
                    "account_capacity",
                    "resource_capacity"
                  ]
                }
              ]
            }
          },
          "description": "Local shared scheduling snapshot. Claimed preparation, prepared holds and possibly active remote attempts reserve capacity; an unclaimed authorization does not. Null capacity is unknown, never unlimited. Worker occupancy is a separate gate. This is not provider quota or a per-job authorization decision.",
          "allOf": [
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "account"
                  }
                }
              },
              "then": {
                "properties": {
                  "resource": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "effective_limit": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "active_attempts": {
                    "type": "null"
                  },
                  "wait_reason": {
                    "enum": [
                      "connection_unverified",
                      "resource_identity_unverified",
                      "resource_reservation_unresolved",
                      "scheduler_clock_unavailable"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "active_attempts": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "resource"
                  },
                  "resource": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "effective_limit": {
                    "type": "null"
                  },
                  "active_attempts": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "new_work": {
                "enum": [
                  "disabled",
                  "removed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "selection": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "authentication": {
                "const": "verified"
              },
              "credential_present": {
                "const": true
              },
              "account_id": {
                "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
              }
            }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connections"
      ],
      "properties": {
        "connections": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/connection"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/connection"
    },
    {
      "$ref": "#/$defs/page"
    }
  ]
}
