{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay structured error v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "stage",
        "safe_operation_retry",
        "compute_may_have_started",
        "recommended_action"
      ],
      "properties": {
        "code": {
          "$ref": "common.v1alpha1.schema.json#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "stage": {
          "$ref": "common.v1alpha1.schema.json#/$defs/failure_stage"
        },
        "request_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/workspace_id"
        },
        "job_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/job_id"
        },
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "operation_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/operation_id"
        },
        "safe_operation_retry": {
          "type": "boolean"
        },
        "compute_may_have_started": {
          "type": "boolean"
        },
        "recommended_action": {
          "$ref": "common.v1alpha1.schema.json#/$defs/recommended_action"
        },
        "details": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          },
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "compute_may_have_started": {
                "const": true
              }
            },
            "required": [
              "compute_may_have_started"
            ]
          },
          "then": {
            "not": {
              "allOf": [
                {
                  "properties": {
                    "safe_operation_retry": {
                      "const": true
                    }
                  }
                },
                {
                  "properties": {
                    "recommended_action": {
                      "const": "retry_compute_explicitly"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
