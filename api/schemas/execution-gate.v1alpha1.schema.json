{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay execution-gate v1alpha1",
  "$defs": {
    "prepare_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "max_preparation_seconds",
        "ready_until",
        "max_staged_bytes",
        "authorize_private_staging"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "max_preparation_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "ready_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "max_staged_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4399824896
        },
        "authorize_private_staging": {
          "const": true
        }
      }
    },
    "start_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "readiness_revision",
        "max_remote_wall_seconds",
        "execution_deadline",
        "authorize_compute"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "readiness_revision": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "max_remote_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "execution_deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "authorize_compute": {
          "const": true
        },
        "secret_authorization_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/operation_id"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "workspace_id",
        "job_id",
        "attempt_id",
        "kind",
        "status",
        "created_at",
        "consumed_at",
        "replay"
      ],
      "properties": {
        "authorization_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/operation_id"
        },
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/workspace_id"
        },
        "job_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/job_id"
        },
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "prepare",
            "start"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "granted",
            "consumed"
          ]
        },
        "created_at": {
          "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
        },
        "consumed_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
            }
          ]
        },
        "replay": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "consumed"
              }
            }
          },
          "then": {
            "properties": {
              "consumed_at": {
                "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
              }
            }
          },
          "else": {
            "properties": {
              "consumed_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "state",
        "observed_at",
        "staged_bytes",
        "required_actions"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/attempt_id"
        },
        "state": {
          "type": "string",
          "enum": [
            "preparation_required",
            "queued",
            "preparing",
            "ready",
            "start_authorized",
            "starting",
            "started",
            "prevented",
            "expired",
            "uncertain",
            "invalidated"
          ]
        },
        "revision": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "observed_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
            }
          ]
        },
        "ready_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "staged_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4399824896
        },
        "required_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "prepare",
              "start",
              "reconcile",
              "cancel",
              "cleanup",
              "supply_secrets",
              "resupply_secrets"
            ]
          }
        },
        "secrets": {
          "$ref": "workload-secrets.v1alpha1.schema.json#/$defs/Readiness"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/prepare_request"
    },
    {
      "$ref": "#/$defs/start_request"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/readiness"
    }
  ]
}
