{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay job specification v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "name",
    "profile",
    "bundle",
    "execution",
    "inputs",
    "outputs",
    "resources",
    "network",
    "timeouts"
  ],
  "properties": {
    "api_version": {
      "const": "compute-connector/v1alpha1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile": {
      "$ref": "common.v1alpha1.schema.json#/$defs/profile_name"
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "common.v1alpha1.schema.json#/$defs/label_key"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      },
      "default": {}
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "sha256": ["bytes"],
        "bytes": ["sha256"]
      },
      "required": [
        "object_id"
      ],
      "properties": {
        "object_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/object_id"
        },
        "sha256": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "application_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "sha256", "bytes"],
      "properties": {
        "object_id": {"$ref": "common.v1alpha1.schema.json#/$defs/object_id"},
        "sha256": {"$ref": "common.v1alpha1.schema.json#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "python",
            "shell"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "working_directory": {
          "$ref": "common.v1alpha1.schema.json#/$defs/relative_path",
          "default": "."
        },
        "environment": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "common.v1alpha1.schema.json#/$defs/environment_name"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "default": {}
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python_requirements": {
              "$ref": "common.v1alpha1.schema.json#/$defs/relative_file_path"
            },
            "shell_setup": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          },
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "python"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "dependencies": {
                "not": {
                  "required": [
                    "shell_setup"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "target"
        ],
        "properties": {
          "name": {
            "$ref": "common.v1alpha1.schema.json#/$defs/input_name"
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "dependentRequired": {
                  "sha256": ["bytes"],
                  "bytes": ["sha256"]
                },
                "required": [
                  "kind",
                  "object_id"
                ],
                "properties": {
                  "kind": {
                    "const": "object"
                  },
                  "object_id": {
                    "$ref": "common.v1alpha1.schema.json#/$defs/object_id"
                  },
                  "sha256": {
                    "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "url"
                ],
                "properties": {
                  "kind": {
                    "const": "https",
                    "description": "Historical source records only. New admission rejects HTTPS sources; upload inputs as objects."
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "maxLength": 4096
                  },
                  "expected_sha256": {
                    "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
                  }
                }
              }
            ]
          },
          "target": {
            "$ref": "common.v1alpha1.schema.json#/$defs/relative_file_path"
          }
        }
      },
      "default": []
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "required"
        ],
        "properties": {
          "path": {
            "$ref": "common.v1alpha1.schema.json#/$defs/relative_file_path"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ],
            "default": "file"
          },
          "required": {
            "type": "boolean"
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967296
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accelerator"
      ],
      "properties": {
        "accelerator": {
          "type": "string",
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "minimum_gpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "minimum_gpu_memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 274877906944
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accelerator": {
                "const": "gpu"
              }
            },
            "required": [
              "accelerator"
            ]
          },
          "then": {
            "required": [
              "minimum_gpu_count"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum_gpu_count"
                  ]
                },
                {
                  "required": [
                    "minimum_gpu_memory_bytes"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_internet"
      ],
      "properties": {
        "remote_internet": {
          "type": "string",
          "enum": [
            "disabled",
            "required"
          ]
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_wall_seconds",
        "setup_seconds",
        "finalization_grace_seconds"
      ],
      "properties": {
        "remote_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "setup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600
        },
        "finalization_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "execution_deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "description": "Immutable UTC setup/payload deadline, in whole seconds. Requires absolute_execution_deadline support. The earlier absolute or relative work budget wins; finalization is separately bounded."
        }
      }
    },
    "result_collection": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "default": "automatic",
      "description": "Frozen per-job result collection policy. Omission preserves automatic collection. Manual requires explicit collect for all results, including diagnostic controls."
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Optional frozen per-job remote cleanup policy. Omission preserves explicit cleanup. When both durations are declared, the uncollected rule applies only until verified publication; the after-collection rule applies after publication.",
      "properties": {
        "after_collection_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2592000,
          "description": "Seconds after durable verified result publication before remote cleanup is due. Zero requests cleanup as soon as publication is committed."
        },
        "uncollected_max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2592000,
          "description": "Seconds after the later of first terminal attempt observation and confirmed remote inactivity (including never-started attempts) before uncollected results may be discarded. Reobservation does not reset the clock. Never permits cleanup while remote activity remains possible."
        }
      }
    },
    "execution_control": {
      "enum": [
        "combined",
        "prepare_then_start"
      ]
    },
    "workload_secrets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "exposure"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "exposure": {
            "type": "string",
            "enum": [
              "file",
              "file_and_local_process_arguments"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "workload_secrets"
        ]
      },
      "then": {
        "required": [
          "execution_control"
        ],
        "properties": {
          "execution_control": {
            "const": "prepare_then_start"
          }
        }
      }
    }
  ]
}
