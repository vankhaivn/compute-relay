{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay job specification v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "name",
    "profile",
    "bundle",
    "execution",
    "inputs",
    "outputs",
    "resources",
    "network",
    "timeouts"
  ],
  "properties": {
    "api_version": {
      "const": "compute-connector/v1alpha1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile": {
      "$ref": "common.v1alpha1.schema.json#/$defs/profile_name"
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "common.v1alpha1.schema.json#/$defs/label_key"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      },
      "default": {}
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id"
      ],
      "properties": {
        "object_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/object_id"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "python",
            "shell"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "working_directory": {
          "$ref": "common.v1alpha1.schema.json#/$defs/relative_path",
          "default": "."
        },
        "environment": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "common.v1alpha1.schema.json#/$defs/environment_name"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "default": {}
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python_requirements": {
              "$ref": "common.v1alpha1.schema.json#/$defs/relative_file_path"
            },
            "shell_setup": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          },
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "python"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "dependencies": {
                "not": {
                  "required": [
                    "shell_setup"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "target"
        ],
        "properties": {
          "name": {
            "$ref": "common.v1alpha1.schema.json#/$defs/input_name"
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "object_id"
                ],
                "properties": {
                  "kind": {
                    "const": "object"
                  },
                  "object_id": {
                    "$ref": "common.v1alpha1.schema.json#/$defs/object_id"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "url"
                ],
                "properties": {
                  "kind": {
                    "const": "https"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "maxLength": 4096
                  },
                  "expected_sha256": {
                    "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
                  }
                }
              }
            ]
          },
          "target": {
            "$ref": "common.v1alpha1.schema.json#/$defs/relative_file_path"
          }
        }
      },
      "default": []
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "required"
        ],
        "properties": {
          "path": {
            "$ref": "common.v1alpha1.schema.json#/$defs/relative_file_path"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ],
            "default": "file"
          },
          "required": {
            "type": "boolean"
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967296
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accelerator"
      ],
      "properties": {
        "accelerator": {
          "type": "string",
          "enum": [
            "cpu",
            "gpu"
          ]
        },
        "minimum_gpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "minimum_gpu_memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 274877906944
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accelerator": {
                "const": "gpu"
              }
            },
            "required": [
              "accelerator"
            ]
          },
          "then": {
            "required": [
              "minimum_gpu_count"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum_gpu_count"
                  ]
                },
                {
                  "required": [
                    "minimum_gpu_memory_bytes"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_internet"
      ],
      "properties": {
        "remote_internet": {
          "type": "string",
          "enum": [
            "disabled",
            "required"
          ]
        }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_wall_seconds",
        "setup_seconds",
        "finalization_grace_seconds"
      ],
      "properties": {
        "remote_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "setup_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600
        },
        "finalization_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
