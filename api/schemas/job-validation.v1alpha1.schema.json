{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay job validation response v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid",
    "warnings",
    "requirements"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "verification"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "verification": {
            "type": "string",
            "enum": [
              "before_dispatch",
              "verify_after_start"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
