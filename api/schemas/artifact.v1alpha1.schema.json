{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay published artifact metadata and pages v1alpha1",
  "description": "Historical verified-publication metadata, not a current byte-read or workload-success claim. Content transfer additionally requires exact hashes, successful EOF and the declared verification trailer.",
  "oneOf": [
    {
      "$ref": "#/$defs/metadata"
    },
    {
      "$ref": "#/$defs/page"
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "role",
        "bytes",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "allOf": [
            {
              "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
            },
            {
              "pattern": "^art_"
            }
          ]
        },
        "path": {
          "allOf": [
            {
              "$ref": "common.v1alpha1.schema.json#/$defs/relative_file_path"
            },
            {
              "pattern": "^[ -~]+$"
            }
          ]
        },
        "role": {
          "enum": [
            "manifest",
            "log",
            "provenance",
            "output"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        },
        "sha256": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "manifest"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "const": "control/execution-result.json"
              },
              "bytes": {
                "maximum": 1048576
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "log"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "enum": [
                  "control/stdout.log",
                  "control/stderr.log"
                ]
              },
              "bytes": {
                "maximum": 20971520
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "provenance"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "const": "control/environment.json"
              },
              "bytes": {
                "maximum": 1048576
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "output"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^outputs/.+"
              },
              "bytes": {
                "maximum": 4294967296
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "job_id",
        "attempt_id",
        "result_phase",
        "verified_at",
        "artifact"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "job_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "result_phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verified_at": {
          "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
        },
        "artifact": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "job_id",
        "attempt_id",
        "result_phase",
        "verified_at",
        "snapshot_sha256",
        "total_artifacts",
        "artifacts",
        "next_cursor"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "job_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "attempt_id": {
          "$ref": "common.v1alpha1.schema.json#/$defs/opaque_id"
        },
        "result_phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verified_at": {
          "$ref": "common.v1alpha1.schema.json#/$defs/rfc3339"
        },
        "snapshot_sha256": {
          "$ref": "common.v1alpha1.schema.json#/$defs/sha256"
        },
        "total_artifacts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10004
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "next_cursor": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^$|^ar1_[0-9a-f]{64}_[1-9][0-9]{0,4}$"
        }
      }
    }
  }
}
