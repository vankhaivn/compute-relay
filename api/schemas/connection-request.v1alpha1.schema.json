{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compute Relay connection-request v1alpha1",
  "$defs": {
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_type",
        "label",
        "credentials"
      ],
      "properties": {
        "provider_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "credentials": {
          "type": "object",
          "writeOnly": true,
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "writeOnly": true
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_remote_wall_seconds"
          ],
          "properties": {
            "max_remote_wall_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400,
              "description": "Maximum remote wall time in seconds for future job admissions."
            },
            "max_active_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "Local concurrency policy override for providers advertising support, from 1 to 64. Omission preserves the existing selection or serial adapter default."
            },
            "max_processes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536,
              "description": "Maximum processes per container for an operator host."
            },
            "storage_budget": {
              "$ref": "common.v1alpha1.schema.json#/$defs/storage_budget_configuration"
            },
            "host_health": {
              "$ref": "#/$defs/host_health"
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "expected_revision"
      ],
      "properties": {
        "action": {
          "enum": [
            "check",
            "replace_credential",
            "disable",
            "enable",
            "remove",
            "configure",
            "install_image"
          ]
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "credentials": {
          "type": "object",
          "writeOnly": true,
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "writeOnly": true
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_remote_wall_seconds"
          ],
          "properties": {
            "max_remote_wall_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400,
              "description": "Maximum remote wall time in seconds for future job admissions."
            },
            "max_active_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "Local concurrency policy override for providers advertising support, from 1 to 64. Omission preserves the existing selection or serial adapter default."
            },
            "max_processes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536,
              "description": "Maximum processes per container for an operator host."
            },
            "storage_budget": {
              "$ref": "common.v1alpha1.schema.json#/$defs/storage_budget_configuration"
            },
            "host_health": {
              "$ref": "#/$defs/host_health"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "replace_credential"
              }
            }
          },
          "then": {
            "required": [
              "credentials"
            ]
          },
          "else": {
            "not": {
              "required": [
                "credentials"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "configure"
              }
            }
          },
          "then": {
            "required": [
              "configuration"
            ]
          },
          "else": {
            "not": {
              "required": [
                "configuration"
              ]
            }
          }
        }
      ]
    },
    "host_health": {
      "$ref": "common.v1alpha1.schema.json#/$defs/host_health_configuration"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/create"
    },
    {
      "$ref": "#/$defs/action"
    }
  ]
}
