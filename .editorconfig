root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.{cmd,bat,ps1}]
end_of_line = crlf
